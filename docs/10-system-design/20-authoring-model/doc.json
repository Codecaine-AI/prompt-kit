    "b-20-authoring-model-surface-how-it-produ-5": {
      "id": "b-20-authoring-model-surface-how-it-produ-5",
      "type": "structured-table",
      "props": {
        "columns": [
          "Surface",
          "How it produces a document"
        ],
        "rows": [
          [
            "TypeScript",
            "Node object literals, typed by the node model, assembled with definePrompt"
          ],
          [
            "JSON",
            "A serialized PromptDocument, checked against the published document schema"
          ],
          [
            "Editor",
            "The prompt editing surface, which commits structural steps against the same document"
          ],
          [
            "External MCP",
            "ID-relative operation batches with guidance, revision checks, and direct persistence."
          ]
