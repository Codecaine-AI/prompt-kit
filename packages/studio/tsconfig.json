{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["bun"],
    // Same pin as packages/prompt-kit: one copy of the React types for the whole program.
    "paths": {
      "react": ["./node_modules/@types/react", "../../node_modules/@types/react", "../../../node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*", "../../node_modules/@types/react/*", "../../../node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom", "../../node_modules/@types/react-dom", "../../../node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*", "../../node_modules/@types/react-dom/*", "../../../node_modules/@types/react-dom/*"]
    }
  },
  "include": ["src/**/*", "server/**/*", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
