    "mcp-add-1": {
      "id": "mcp-add-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The pure Prompt Kit library does not register runtime tools. The separate MCP adapter exposes prompt-authoring operations, and the shared filesystem store coordinates those writes with Kernel catalog saves. Runtime tool execution, sessions, database ownership, and model invocation remain Kernel responsibilities."
        }
      ],
      "children": []
    },
    "mcp-add-2": {
      "id": "mcp-add-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Kernel refreshes its registry and records committed revisions after saves. New runs synchronize disk changes before freezing their prompt; existing runs keep their frozen prompt. See "
        },
        {
          "insert": "Persistence and Recovery",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/90-external-authoring/30-persistence"
            }
