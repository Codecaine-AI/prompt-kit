    "b-20-ui-decision-a-step-pro-15": {
      "id": "b-20-ui-decision-a-step-pro-15",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " A step producer reads the "
        },
        {
          "insert": "PromptDocument",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", never mutates it,\nand returns steps plus a focus target. Returning "
        },
        {
          "insert": "null",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " declines the gesture, decline-by-null means fall through to the next handler, not failure."
        }
      ],
      "children": []
    },
    "b-20-ui-why-producers-compo-16": {
      "id": "b-20-ui-why-producers-compo-16",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Producers compose into keymaps and menus without side effects, and\ndeclining cleanly lets gestures layer."
        }
      ],
      "children": []
    },
