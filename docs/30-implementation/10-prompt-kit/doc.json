    "b-00-overview-decision-the-packag-14": {
      "id": "b-00-overview-decision-the-packag-14",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision. The package exposes seven entry points. The root export owns headless document APIs; ./annotations owns annotation state; ./authoring owns pure ID-relative compilation, address maps, schemas, and profile lints. ./ui owns headless editor models, while ./ui/lab, ./ui/style, and ./ui/surface own React surfaces."
        }
      ],
      "children": []
    },
    "b-00-overview-why-the-default-imp-15": {
      "id": "b-00-overview-why-the-default-imp-15",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " The default import stays framework-free, so servers, scripts, and\nkernels consume prompt documents without pulling in React."
        }
      ],
      "children": []
    },
