    "b-80-kernel-boundary-viewer-systems-can-impor-19": {
      "id": "b-80-kernel-boundary-viewer-systems-can-impor-19",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Viewer systems can import prompt-kit UI helpers such as\n"
        },
        {
          "insert": "createPromptEditorModel",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", a headless model that returns the prompt with\nstable ids, its flattened tree, rendered output, and validation result. The\nReact-facing surfaces, the editing surface, the lab shell, the style\nsettings, and the read-only prompt view, sit behind dedicated UI entry\npoints; their behavior is specified in\n"
        },
        {
          "insert": "Prompt Editor",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/60-editor"
            }
          }
        },
        {
          "insert": ". None of this defines a\nfull UI framework or host app shell."
        }
      ],
      "children": []
    },
