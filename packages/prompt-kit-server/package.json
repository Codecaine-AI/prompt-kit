{
  "name": "@codecaine-ai/prompt-kit-server",
  "version": "0.0.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Codecaine-AI/prompt-kit.git",
    "directory": "packages/prompt-kit-server"
  },
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./guidance": "./src/guidance.ts"
  },
  "scripts": {
    "test": "bun test tests",
    "typecheck": "bunx --bun tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@codecaine-ai/docs-model": "workspace:*",
    "@codecaine-ai/prompt-kit": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__",
    "!src/**/__fixtures__",
    "!src/**/__snapshots__",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
