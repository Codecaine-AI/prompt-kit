    "b-50-validation-contract-ts-6": {
      "id": "b-50-validation-contract-ts-6",
      "type": "code",
      "props": {
        "language": "ts"
      },
      "text": [
        {
          "insert": "interface PromptValidationResult {\n  ok: boolean;\n  diagnostics: PromptDiagnostic[];\n}"
        }
      ],
      "children": []
    },
    "b-50-validation-contract-diagnostics-include-seve-7": {
      "id": "b-50-validation-contract-diagnostics-include-seve-7",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Diagnostics include severity, code, message, path, and optional node id. The\nresult is "
        },
        {
          "insert": "ok",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " when no diagnostic carries "
        },
        {
          "insert": "severity: \"error\"",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "; warnings do not\nblock. The validator runs document-level checks first, then traverses the full\ntree, blocks, list items, and inline nodes, collecting ids and checking each\nnode in place, so one pass reports every problem rather than stopping at the\nfirst."
        }
      ],
      "children": []
    },
    "b-50-validation-contract-two-validation-layers-8": {
