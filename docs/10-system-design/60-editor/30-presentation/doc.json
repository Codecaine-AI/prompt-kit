    "b-30-presentation-line-numbers-default-off-12": {
      "id": "b-30-presentation-line-numbers-default-off-12",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Line numbers default off: the flow renders a structured document whose address\nsystem is node ids and targeting rings, not source lines. The \"Line numbers\"\ntoggle (and the "
        },
        {
          "insert": "classic",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " preset) restores the numbered gutter, which then\ntracks the raw view line for line. With numbers off the gutter collapses to\nthe width the drag affordances need."
        }
      ],
      "children": []
    },
