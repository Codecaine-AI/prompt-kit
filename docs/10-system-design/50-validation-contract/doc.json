    "b-50-validation-contract-custom-section-tags-met-25": {
      "id": "b-50-validation-contract-custom-section-tags-met-25",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Custom section tags, metadata, and archetype strings are valid when they satisfy\nthe small structural requirements. The validator provides a safety floor while\nleaving room for new prompt families."
        }
      ],
      "children": []
    },
    "mcp-add-0": {
      "id": "mcp-add-0",
      "type": "heading",
      "props": {
        "level": 2
