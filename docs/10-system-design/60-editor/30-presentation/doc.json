    "b-30-presentation-indent-geometry-has-two-15": {
      "id": "b-30-presentation-indent-geometry-has-two-15",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Indent geometry has two forms. Rows and the highlighter measure the leading spaces they rendered. Guide and drop-indicator overlays start from a node's depth without reading its text. Both resolve to the same visual width: one nesting level is four rendered spaces, which is two indent widths."
        }
      ],
      "children": []
    },
