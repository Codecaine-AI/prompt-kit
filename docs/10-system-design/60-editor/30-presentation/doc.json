    "b-30-presentation-stored-differs-29": {
      "id": "b-30-presentation-stored-differs-29",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "A stored value always differs from the defaults. Saving settings equal to the defaults removes the entry, so a reset leaves the application defaults as the source of truth."
        }
      ],
      "children": []
    },
    "b-30-presentation-loader-30": {
      "id": "b-30-presentation-loader-30",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "A missing entry, an unknown payload version, malformed JSON, or unavailable storage yields the defaults."
        }
      ],
      "children": []
    },
    "b-30-presentation-best-effort-31": {
      "id": "b-30-presentation-best-effort-31",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Writes are best effort. If storage rejects a write, the settings still apply for the session."
        }
      ],
      "children": []
    },
    "b-30-presentation-tab-sync-32": {
      "id": "b-30-presentation-tab-sync-32",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Open tabs stay in sync. The settings hook reloads the stored value when a storage event names the key."
        }
      ],
      "children": []
    },
    "b-30-presentation-projecting-settings-yiel-19": {
      "id": "b-30-presentation-projecting-settings-yiel-19",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Projecting settings yields a record of "
        },
        {
          "insert": "--prompt-editor-*",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " values, ready to apply as inline custom properties."
        }
      ],
      "children": []
    },
    "b-30-presentation-host-wiring-20": {
      "id": "b-30-presentation-host-wiring-20",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Host Wiring"
        }
      ],
      "children": []
    },
    "b-30-presentation-the-host-owns-the-settin-21": {
      "id": "b-30-presentation-the-host-owns-the-settin-21",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The host owns the settings and mounts the sidebar that edits them. The lab shell takes a settings prop, projects it, and applies the result on its root. When the prop is omitted, the lab reads the persisted settings once on mount. The lab also takes a follow-theme prop, which makes projection reference the host theme for every color."
        }
      ],
      "children": []
    },
    "b-30-presentation-the-read-only-prompt-vie-22": {
      "id": "b-30-presentation-the-read-only-prompt-vie-22",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The read-only prompt view takes an inherit-style flag for exactly this case: a\nhost that already projects live variables passes it so rail changes apply\nwithout a remount, instead of the view applying persisted settings locally."
        }
      ],
      "children": []
    },
    "b-30-presentation-style-rail-33": {
      "id": "b-30-presentation-style-rail-33",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The style rail is a controlled component. It receives the settings and reports each change, reset, and close to the host. Its controls sit in five foldout sections: "
        },
        {
          "insert": "Type",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "Layout",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "Syntax colors",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "Marks",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "Interaction",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ". The sidebar wraps the rail in a resizable panel that either docks in the host layout or floats over a scrim."
        }
      ],
      "children": []
    }
