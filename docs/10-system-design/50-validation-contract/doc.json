    "mcp-add-1": {
      "id": "mcp-add-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The pure document validator remains permissive about valid custom tags and archetypes. External authoring explicitly selects agent, single-output, or generic writing profiles. Deterministic profile findings are returned after saves and must pass completion checks."
        }
      ],
      "children": []
    },
    "mcp-add-2": {
      "id": "mcp-add-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "MCP mutation reloads authoritative variable declarations under the save lock and checks structured variable nodes plus raw rendered placeholders. Unknown standalone declarations block mutation and successful completion; an explicit empty declaration means no variables. See "
        },
        {
          "insert": "MCP Protocol",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/90-external-authoring/10-protocol"
            }
