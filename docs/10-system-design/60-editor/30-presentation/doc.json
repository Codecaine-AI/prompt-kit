    "b-30-presentation-color-theme-25": {
      "id": "b-30-presentation-color-theme-25",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Every color token resolves in order: the "
        },
        {
          "insert": "--prompt-editor-*",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " value, then a host theme "
        },
        {
          "insert": "--editor-*",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " token, then a dark literal. Projection emits a color that equals its default as a reference to the host theme token, so an untouched palette follows the host theme. A customized color is emitted as a literal and overrides the host theme. With the follow-theme option, projection references the host theme for every color. The saved colors stay stored, and the opacity and layout settings still apply."
        }
      ],
      "children": []
    },
    "b-30-presentation-tag-ink-26": {
      "id": "b-30-presentation-tag-ink-26",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Tag rows set their own ink. An open or close tag at depth 0 takes "
        },
        {
          "insert": "--prompt-editor-syntax-tag-landmark",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and one at depth 1 takes "
        },
        {
          "insert": "--prompt-editor-syntax-tag-sublandmark",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The highlighter reads tag weight from "
        },
        {
          "insert": "--prompt-editor-tag-weight",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", 500 by default. Editor rows set it to 700 on an open tag and 600 on a close tag. A host overrides those two weights through "
        },
        {
          "insert": "--prompt-editor-open-tag-weight",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "--prompt-editor-close-tag-weight",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
