      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Every block carries one left-edge affordance, pinned just inside the gutter at\nits first row. It is the drag handle, and clicking it opens a compact menu."
        }
      ],
      "children": []
    },
