    "b-10-canonical-prompt-object-ts-6": {
      "id": "b-10-canonical-prompt-object-ts-6",
      "type": "code",
      "props": {
        "language": "ts"
      },
      "text": [
        {
          "insert": "interface PromptDocument {\n  kind: \"prompt\";\n  schemaVersion: \"prompt-kit/v1\";\n  id: string;\n  title?: string;\n  description?: string;\n  archetype?: \"singleOutput\" | \"workflow\" | (string & {});\n  nodes: PromptBlockNode[];\n  metadata?: Record<string, unknown>;\n}"
        }
      ],
      "children": []
    },
    "b-10-canonical-prompt-object-the-document-is-intentio-7": {
      "id": "b-10-canonical-prompt-object-the-document-is-intentio-7",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The document is intentionally generic. "
        },
        {
          "insert": "archetype",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " helps templates and tooling\nunderstand broad intent, while "
        },
        {
          "insert": "nodes",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " carries the real prompt body."
        }
      ],
      "children": []
