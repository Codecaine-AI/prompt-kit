    "b-40-block-vocabulary-field-example-con-9": {
      "id": "b-40-block-vocabulary-field-example-con-9",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "field",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "example",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "contextUsage",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "raw",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " are part of the model and are\nfully supported by the surface, they render into rows, they are\ninline-editable where they have an editable value, they can be selected,\nmoved, duplicated, and deleted, and the details inspector edits their\nproperties. They are simply not offered as things to create from this UI."
        }
      ],
      "children": []
    },
