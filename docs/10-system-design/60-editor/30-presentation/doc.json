    "b-30-presentation-presentation-is-a-set-of-2": {
      "id": "b-30-presentation-presentation-is-a-set-of-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Presentation is a set of CSS custom properties. The editable surface and the\nread-only prompt view read the same tokens, so switching between them reads as\ntoggling editability rather than opening a different document."
        }
      ],
      "children": []
    },
    "b-30-presentation-divider-3": {
