    "b-10-editing-model-the-editor-edits-a-prom-2": {
      "id": "b-10-editing-model-the-editor-edits-a-prom-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The editor edits a "
        },
        {
          "insert": "PromptDocument",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The XML text on screen is a rendered\nprojection of that document, and every keystroke that changes structure or\ntext is committed as a step through a transaction log."
        }
      ],
      "children": []
    },
    "b-10-editing-model-divider-3": {
