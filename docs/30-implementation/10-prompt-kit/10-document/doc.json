    "b-10-document-decision-runtime-va-16": {
      "id": "b-10-document-decision-runtime-va-16",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Runtime values enter a prompt through "
        },
        {
          "insert": "variable",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " nodes, declared runtime boundaries, never through raw text placeholders. "
        },
        {
          "insert": "raw",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " nodes\nare reserved for content no structured node can express."
        }
      ],
      "children": []
    },
    "b-10-document-why-raw-placeholder-17": {
      "id": "b-10-document-why-raw-placeholder-17",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Raw placeholders and host string interpolation defeat validation\n(undeclared variables go undetected) and structural diffing."
        }
      ],
      "children": []
    },
    "b-10-document-applies-to-any-new-18": {
      "id": "b-10-document-applies-to-any-new-18",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Applies to.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Any new injection point for runtime data is a "
        },
        {
          "insert": "variable",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "\nnode; adding placeholder syntax inside text content is a restructure, not an\nextension."
        }
      ],
      "children": []
    },
    "b-10-document-transforms-operate-on-as-19": {
      "id": "b-10-document-transforms-operate-on-as-19",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "Transforms operate on AST nodes, never strings"
        }
      ],
      "children": []
    },
    "b-10-document-decision-transforms-20": {
      "id": "b-10-document-decision-transforms-20",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Transforms are immutable and id-targeted, insert, replace, and\nomit address nodes by id and return new documents. They operate at block\nscope only; inline transforms build on "
        },
        {
          "insert": "visitPrompt",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " when needed."
        }
      ],
      "children": []
    },
    "b-10-document-why-string-rewritin-21": {
      "id": "b-10-document-why-string-rewritin-21",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " String rewriting breaks the canonical shape and destroys stable node\nids, which addressing, diffing, and annotation all depend on."
        }
      ],
      "children": []
    },
    "b-10-document-applies-to-every-ne-22": {
      "id": "b-10-document-applies-to-every-ne-22",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Applies to.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Every new transform takes and returns documents, targets ids,\nand never mutates its input."
        }
      ],
      "children": []
    },
