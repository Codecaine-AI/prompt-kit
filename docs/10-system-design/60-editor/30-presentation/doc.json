      "text": [
        {
          "insert": "A host may set any "
        },
        {
          "insert": "--prompt-editor-*",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " property on the surface element or one of its ancestors. Every token has a literal fallback, so the components render correctly with no host variables set at all. A stable root class, "
        },
        {
          "insert": "prompt-editor-surface",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", marks the scoped element, so descendants can observe style changes on it. "
        },
        {
          "insert": "packages/prompt-kit/src/ui/surface/editor-surface.ts",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages/prompt-kit/src/ui/surface/editor-surface.ts"
            }
          }
        },
        {
          "insert": " defines the tokens and their fallbacks."
        }
      ],
      "children": []
    },
