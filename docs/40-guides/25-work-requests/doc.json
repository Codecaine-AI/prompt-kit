        "wq-52"
      ]
    },
    "wq-51": {
      "id": "wq-51",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "prompts_apply_ops",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " saves at once, with no staged review."
        }
      ],
      "children": []
    },
    "wq-52": {
      "id": "wq-52",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A close takes one "
        },
        {
          "insert": "body",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " sentence, not an outcome and a note."
