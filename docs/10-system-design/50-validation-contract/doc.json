    "b-50-validation-contract-semantic-validation-assu-9": {
      "id": "b-50-validation-contract-semantic-validation-assu-9",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Semantic validation assumes it is looking at a "
        },
        {
          "insert": "PromptDocument",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". For untrusted\ninput, a JSON file, a save-endpoint body, the schema module's shape check\n("
        },
        {
          "insert": "validatePromptDocumentShape",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", mirroring the published JSON Schema) runs\nfirst and reports structural mismatches by path. See\n"
        },
        {
          "insert": "Authoring Model",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/20-authoring-model"
            }
          }
        },
        {
          "insert": " for the JSON authoring form."
        }
      ],
      "children": []
    },
