      "children": [
        "cg-8",
        "cg-9",
        "cg-10"
      ]
    },
    "cg-8": {
      "id": "cg-8",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Each source in "
        },
        {
          "insert": "GUIDANCE_SOURCE_MANIFEST",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " names its topic, and the task's pinned snapshot holds the topics of its profile."
        }
      ],
      "children": []
    },
    "cg-9": {
      "id": "cg-9",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A topic over 24,576 bytes splits into parts and is never truncated. The "
        },
        {
          "insert": "agent",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "single-output",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " standards topics have 2 parts."
        }
      ],
      "children": []
    },
    "cg-10": {
      "id": "cg-10",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The "
        },
        {
          "insert": "codecaine://prompts/guidance",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " resource returns the topic index."
        }
      ],
      "children": []
    },
    "cg-11": {
      "id": "cg-11",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "prompts_begin",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " pins the profile and the guidance snapshot, and returns task state only."
        }
      ],
      "children": [
        "cg-12"
      ]
    },
    "cg-12": {
      "id": "cg-12",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A task expires 30 minutes after its last call or 12 hours after "
        },
        {
          "insert": "prompts_begin",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". "
        },
        {
          "insert": "prompts_check",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " with "
        },
        {
          "insert": "task_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " carries the task report."
        }
      ],
      "children": []
    },
    "cg-13": {
      "id": "cg-13",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "prompts_apply_ops",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is refused until the task reads every part of topic "
        },
        {
          "insert": "standards",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " at the pinned snapshot."
        }
      ],
      "children": [
        "cg-14"
      ]
    },
    "cg-14": {
      "id": "cg-14",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The refusal names "
        },
        {
          "insert": "prompts_guidance(task_id, topic='standards')",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Every read and every other write stays open."
        }
      ],
      "children": []
    },
    "cg-15": {
      "id": "cg-15",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "MCP_INSTRUCTIONS",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in "
        },
        {
          "insert": "src/instructions.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the prompt block, 800 bytes or less."
        }
      ],
      "children": [
        "cg-16"
      ]
    },
