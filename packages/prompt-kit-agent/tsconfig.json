{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"outDir": "dist",
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"types": ["bun"],
		"noEmit": true,
		"paths": {
			"@sinclair/typebox": ["./node_modules/@sinclair/typebox", "../../node_modules/@sinclair/typebox", "../../../node_modules/@sinclair/typebox"],
			"@sinclair/typebox/*": ["./node_modules/@sinclair/typebox/*", "../../node_modules/@sinclair/typebox/*", "../../../node_modules/@sinclair/typebox/*"],
			"react": ["./node_modules/@types/react", "../../node_modules/@types/react", "../../../node_modules/@types/react"],
			"react/*": ["./node_modules/@types/react/*", "../../node_modules/@types/react/*", "../../../node_modules/@types/react/*"],
			"react-dom": ["./node_modules/@types/react-dom", "../../node_modules/@types/react-dom", "../../../node_modules/@types/react-dom"],
			"react-dom/*": ["./node_modules/@types/react-dom/*", "../../node_modules/@types/react-dom/*", "../../../node_modules/@types/react-dom/*"]
		}
	},
	"include": ["src", "test", "catalog"],
	"exclude": ["node_modules", "dist"]
}
