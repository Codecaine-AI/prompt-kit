    "b-30-presentation-the-host-facing-settings-17": {
      "id": "b-30-presentation-the-host-facing-settings-17",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The host-facing settings object is a flat record of metrics, toggles, and\ncolors, normalized on every read and write: numbers clamp, enums validate, and\nmissing values fall back."
        }
      ],
      "children": []
    },
    "b-30-presentation-setting-concept-beha-18": {
      "id": "b-30-presentation-setting-concept-beha-18",
      "type": "structured-table",
      "props": {
        "columns": [
          "Setting concept",
          "Behavior"
        ],
        "rows": [
          [
            "Row shading",
            "One three-way choice, none, rules, or zebra, because rules and zebra are alternative answers to the same question; the choice maps onto the two visibility multipliers"
          ],
          [
            "Mono font",
            "A named font choice from a small vetted set"
          ],
          [
            "Presets",
            "Named bundles (dense, balanced, reading); balanced is the default"
          ],
          [
            "Persistence",
            "Settings round-trip through local storage under a versioned key; open tabs stay in sync by observing storage events"
          ]
        ]
      },
      "children": []
    },
