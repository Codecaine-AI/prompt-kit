    "b-80-kernel-boundary-a-host-keeps-a-promptdo-5": {
      "id": "b-80-kernel-boundary-a-host-keeps-a-promptdo-5",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A host keeps a "
        },
        {
          "insert": "PromptDocument",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " as the source of truth for each agent's system\nprompt. The host registry imports that document, validates it with host\ndeclarations (declared variables, host-specific checks), renders it, and\npasses the rendered system prompt to the runtime. The document, not the\nrendered string, is what the host stores, diffs, and edits."
        }
      ],
      "children": []
    },
