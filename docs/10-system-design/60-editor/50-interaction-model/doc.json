      },
      "text": [
        {
          "insert": "Annotate Mode"
        }
      ],
      "children": []
    },
    "b-50-interaction-model-in-the-ai-state-the-gla-13": {
      "id": "b-50-interaction-model-in-the-ai-state-the-gla-13",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "In the AI state (the glass panel's "
        },
        {
          "insert": "✦",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " tab) the vocabulary changes owner: the\nshared annotations package drives hover rings, click-to-pin, and Cmd+drag\nrange annotation, and every editing affordance is hidden. While a composer is\nopen the pin is STICKY, document clicks neither cancel nor re-target it; only\nits × or Escape close it. See the annotations package\n("
        },
        {
          "insert": "@codecaine-ai/annotations",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") for the mode's standard and\n"
        },
        {
          "insert": "Application Shell",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/60-editor/60-application-shell"
            }
          }
        },
        {
          "insert": " for the queue it feeds."
        }
      ],
      "children": []
    },
    "b-50-interaction-model-the-one-handle-drag-mode-14": {
      "id": "b-50-interaction-model-the-one-handle-drag-mode-14",
