    "b-20-authoring-model-all-three-converge-on-on-6": {
      "id": "b-20-authoring-model-all-three-converge-on-on-6",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "These surfaces converge on one object. The document does not record which authoring surface produced it, so a prompt can move between code, files, the editor, and external tools."
