        }
      ],
      "children": []
    },
    "b-10-editing-model-the-surface-never-parses-5": {
      "id": "b-10-editing-model-the-surface-never-parses-5",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The surface never parses the rendered string back into nodes. A row knows\nwhich node it came from, an editor knows which property of that node it edits,\nand a commit writes that property back into the document."
        }
      ],
      "children": []
    },
