    "b-20-ui-decision-reparentin-19": {
      "id": "b-20-ui-decision-reparentin-19",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Reparenting uses the shared remove-then-insert helpers so the\nsame node ids re-attach at the new location. Multi-step gestures commit as one\ntransaction, a single undo entry."
        }
      ],
      "children": []
    },
    "b-20-ui-why-id-preservation-20": {
      "id": "b-20-ui-why-id-preservation-20",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Id preservation keeps the canonical content hash stable across\nnesting-only moves and keeps the caret in the moved block; one transaction per\ngesture keeps undo aligned with user intent."
        }
      ],
      "children": []
    },
    "b-20-ui-applies-to-every-ne-21": {
      "id": "b-20-ui-applies-to-every-ne-21",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Applies to.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Every new move or reparent gesture reuses the shared helpers\nand commits atomically; a move that recreates nodes with fresh ids is a bug."
        }
      ],
      "children": []
    }
