      "children": []
    },
    "b-80-kernel-boundary-prompt-kit-should-not-re-16": {
      "id": "b-80-kernel-boundary-prompt-kit-should-not-re-16",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Prompt-kit should not register tools. A prompt can include a "
        },
        {
          "insert": "tool_policy",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "\nsection or a reference placeholder, but the host decides which shared tools,\nprivate tools, or Pi-compatible registrations are available."
        }
      ],
      "children": []
    },
    "b-80-kernel-boundary-this-keeps-prompt-text-a-17": {
      "id": "b-80-kernel-boundary-this-keeps-prompt-text-a-17",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "This keeps prompt text aligned with runtime behavior without coupling the prompt\nAST package to one SDK."
        }
      ],
      "children": []
    },
