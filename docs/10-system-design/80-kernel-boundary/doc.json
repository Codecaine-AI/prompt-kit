    "b-80-kernel-boundary-prompt-kit-is-a-prompt-a-2": {
      "id": "b-80-kernel-boundary-prompt-kit-is-a-prompt-a-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Prompt-kit is a prompt authoring and rendering layer. A kernel consumes its\nprompt documents as one part of a larger runtime packet."
        }
      ],
      "children": []
    },
