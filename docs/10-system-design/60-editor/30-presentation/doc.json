          "insert": "Viewer-Only Guarantee"
        }
      ],
      "children": []
    },
    "b-30-presentation-nothing-in-this-contract-5": {
      "id": "b-30-presentation-nothing-in-this-contract-5",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Nothing in this contract touches the document. Style settings change no node,\nno rendered string, and no content hash; they are not persisted with the\nprompt and they are not part of a save. Row shading, guides, and line numbers\nare painted with zero-layout-cost backgrounds and visibility multipliers, so\ntoggling them never changes row geometry either."
        }
      ],
      "children": []
    },
    "b-30-presentation-variable-contract-6": {
