    "b-30-presentation-the-host-facing-settings-17": {
      "id": "b-30-presentation-the-host-facing-settings-17",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The host-facing settings object is a flat record of metrics, one guide toggle, and colors. Every read and write normalizes it: numbers clamp to their range, the font choice validates against the named set, colors canonicalize to uppercase "
        },
        {
          "insert": "#RRGGBB",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and a missing or invalid value falls back to its default."
        }
      ],
      "children": []
    },
