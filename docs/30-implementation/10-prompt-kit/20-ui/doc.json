    "b-20-ui-decision-models-st-10": {
      "id": "b-20-ui-decision-models-st-10",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Models, steps, transactions, and session logic are pure modules\nwith no runtime React or DOM dependency, the editor model, transactions, the\nstructure and list-item steps, autoformat, slash commands and the slash\nsession, edit navigation, the autosave controller, lab history, and style\nsettings. React components live in separate "
        },
        {
          "insert": ".tsx",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " modules that consume them."
        }
      ],
      "children": []
    },
    "b-20-ui-why-the-full-shell-11": {
