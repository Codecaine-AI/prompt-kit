    "b-30-rendering-model-prompt-kit-separates-pro-2": {
      "id": "b-30-rendering-model-prompt-kit-separates-pro-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Prompt-kit separates prompt structure from rendered output. The default renderer\nturns the AST into XML-tagged Markdown, which keeps the final prompt readable for\nagents and inspectable for humans."
        }
      ],
      "children": []
