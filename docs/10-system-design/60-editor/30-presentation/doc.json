        }
      ],
      "children": []
    },
    "b-30-presentation-a-host-may-set-any-pr-7": {
      "id": "b-30-presentation-a-host-may-set-any-pr-7",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A host may set any "
        },
        {
          "insert": "--prompt-editor-*",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " property on the surface element or one\nof its ancestors. Every token has a literal fallback, so the components render\ncorrectly with no host variables set at all. A stable root class marks the\nscoped element, so descendants can observe style changes on it."
        }
      ],
      "children": []
    },
