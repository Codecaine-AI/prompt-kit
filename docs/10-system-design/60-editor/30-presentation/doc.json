    "b-30-presentation-nothing-in-this-contract-5": {
      "id": "b-30-presentation-nothing-in-this-contract-5",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Nothing in this contract touches the document. Style settings change no node, no rendered string, and no content hash. They are not persisted with the prompt and they are not part of a save. Indent guides are painted as background stripes in the read-only view and as positioned overlays in the editor, so toggling them never changes row geometry."
        }
      ],
      "children": []
    },
