    "b-20-ui-why-id-preservation-20": {
      "id": "b-20-ui-why-id-preservation-20",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Id preservation keeps the canonical content hash stable across nesting-only moves and keeps the caret in the moved block. One transaction per gesture keeps undo aligned with user intent."
        }
      ],
      "children": []
    },
    "b-20-ui-applies-to-every-ne-21": {
      "id": "b-20-ui-applies-to-every-ne-21",
