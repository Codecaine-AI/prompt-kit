    "b-00-overview-the-prompt-editor-presen-2": {
      "id": "b-00-overview-the-prompt-editor-presen-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The prompt editor presents a "
        },
        {
          "insert": "PromptDocument",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " as editable XML-tagged Markdown.\nThe document is canonical: the text on screen is a rendered projection, every\ngesture commits as a structural step, and the rendered string is never parsed\nback into nodes."
        }
      ],
      "children": []
    },
    "b-00-overview-these-pages-specify-the-3": {
      "id": "b-00-overview-these-pages-specify-the-3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "These pages specify the editor's behavior, what a keystroke, click, or drag\nmeans, independent of any host application."
        }
      ],
      "children": []
    },
