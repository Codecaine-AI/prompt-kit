        },
        {
          "insert": "--prompt-editor-active-line-bg",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "--prompt-editor-hover-bg",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " are consumed\ndirectly by the components. Syntax tokens, "
        },
        {
          "insert": "--prompt-editor-syntax-punctuation",
