      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "MCP Protocol",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/90-external-authoring/10-protocol"
            }
          }
        },
        {
          "insert": " owns public task behavior; "
        },
        {
          "insert": "Prompt Edit Transaction Guide",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/90-external-authoring/20-operations"
