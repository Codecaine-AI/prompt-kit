{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "bun"
    ],
    "paths": {
      "@sinclair/typebox": [
        "./node_modules/@sinclair/typebox",
        "../../node_modules/@sinclair/typebox",
        "../../../node_modules/@sinclair/typebox"
      ],
      "@sinclair/typebox/*": [
        "./node_modules/@sinclair/typebox/*",
        "../../node_modules/@sinclair/typebox/*",
        "../../../node_modules/@sinclair/typebox/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
