      "id": "b-50-techniques-risk-before-technique-5",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Risk Before Technique"
        }
      ],
      "children": []
    },
    "b-50-techniques-reasoning-and-quality-ri-6": {
      "id": "b-50-techniques-reasoning-and-quality-ri-6",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Reasoning and quality risks suggest one set of interventions:"
        }
      ],
      "children": []
    },
    "b-50-techniques-risk-useful-starting-7": {
      "id": "b-50-techniques-risk-useful-starting-7",
      "type": "structured-table",
      "props": {
        "columns": [
