    "b-30-presentation-stored-settings-28": {
      "id": "b-30-presentation-stored-settings-28",
      "type": "state-shape",
      "props": {
        "description": "The JSON value saved to local storage. The settings field holds a complete PromptStyleSettings value.",
        "example": "{\n  \"version\": 3,\n  \"settings\": {\n    \"fontFamily\": \"jetbrains-mono\",\n    \"fontSize\": 14,\n    \"lineHeight\": 26,\n    \"letterSpacing\": 0,\n    \"indentWidth\": 20,\n    \"contentWidth\": 96,\n    \"marginLeft\": 48,\n    \"marginTop\": 24,\n    \"panelInset\": 24,\n    \"panelTopInset\": 12,\n    \"composerWidth\": 640,\n    \"landmarkFontScale\": 1.08,\n    \"gapRamp\": 0.5,\n    \"showGuides\": true,\n    \"surfaceColor\": \"#1E1E1E\",\n    \"foregroundColor\": \"#D4D6D3\",\n    \"gutterColor\": \"#1E1E1E\",\n    \"lineNumberColor\": \"#5F6672\",\n    \"activeLineNumberColor\": \"#C6CCD2\",\n    \"tagPunctuationColor\": \"#6E7681\",\n    \"tagNameColor\": \"#9A7CAC\",\n    \"tagLandmarkColor\": \"#CBA6DE\",\n    \"tagSublandmarkColor\": \"#B48EC7\",\n    \"attributeNameColor\": \"#85AECB\",\n    \"attributeValueColor\": \"#C09A78\",\n    \"variableColor\": \"#CFBC74\",\n    \"referenceColor\": \"#58A794\",\n    \"inlineCodeColor\": \"#5FBCA5\",\n    \"inlineChipOpacity\": 0.08,\n    \"listMarkerColor\": \"#6C737B\",\n    \"guideColor\": \"#FFFFFF\",\n    \"guideOpacity\": 0.18,\n    \"landmarkColor\": \"#FFFFFF\",\n    \"landmarkOpacity\": 0,\n    \"selectionColor\": \"#3D7BBF\",\n    \"selectionOpacity\": 0.16,\n    \"selectionAccentColor\": \"#4D9DE0\",\n    \"activeLineColor\": \"#FFFFFF\",\n    \"activeLineOpacity\": 0.035,\n    \"hoverColor\": \"#FFFFFF\",\n    \"hoverOpacity\": 0.05,\n    \"gripColor\": \"#8A919C\",\n    \"gripSize\": 20,\n    \"gripOpacity\": 0.5,\n    \"dropIndicatorColor\": \"#4D9DE0\",\n    \"dropIndicatorWidth\": 2,\n    \"dropIndicatorOpacity\": 0.95\n  }\n}",
        "fields": [
          {
            "name": "version",
            "type": "number",
            "description": "Payload version. The writer emits 3. The loader accepts 2 and 3."
          },
          {
            "name": "settings",
            "type": "object",
            "description": "A complete normalized value, never a patch.",
            "fields": [
              {
                "name": "fontFamily",
                "type": "\"sans\" | \"system\" | \"sf-mono\" | \"jetbrains-mono\" | \"ibm-plex-mono\""
              },
              {
                "name": "fontSize",
                "type": "number",
                "description": "Pixels, 10 to 24."
              },
              {
                "name": "lineHeight",
                "type": "number",
                "description": "Pixels, 14 to 40."
              },
              {
                "name": "letterSpacing",
                "type": "number",
                "description": "Em, -0.05 to 0.15."
              },
              {
                "name": "indentWidth",
                "type": "integer",
                "description": "Pixels, 12 to 48."
              },
              {
                "name": "contentWidth",
                "type": "integer",
                "description": "Characters, 60 to 180."
              },
              {
                "name": "marginLeft",
                "type": "integer",
                "description": "Pixels, 0 to 240."
              },
              {
                "name": "marginTop",
                "type": "integer",
                "description": "Pixels, 0 to 160."
              },
              {
