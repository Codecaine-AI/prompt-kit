    "b-50-techniques-techniques-are-available-2": {
      "id": "b-50-techniques-techniques-are-available-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Techniques are available context, not a required checklist. They help when a\nprompt has a specific, observable failure risk; they add noise when included\nonly because a technique sounds sophisticated."
        }
      ],
      "children": []
    },
    "b-50-techniques-select-from-risk-to-tech-3": {
      "id": "b-50-techniques-select-from-risk-to-tech-3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Select from risk to technique. Name what is likely to go wrong, choose the\nsmallest intervention that changes that behavior, and leave everything else\nout. Choosing no framework is a legal answer, and it is the right answer for\nmost straightforward prompts."
        }
      ],
      "children": []
    },
    "b-50-techniques-divider-4": {
      "id": "b-50-techniques-divider-4",
      "type": "divider",
      "props": {},
      "children": []
    },
