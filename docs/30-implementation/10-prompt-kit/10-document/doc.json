      "text": [
        {
          "insert": "Decision.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " The validator accepts host declarations (for example\n"
        },
        {
          "insert": "declaredVariables",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") as parameters. The document core never imports from a\nhost."
