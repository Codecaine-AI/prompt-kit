    },
    "b-10-editing-model-the-line-projection-see-8": {
      "id": "b-10-editing-model-the-line-projection-see-8",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The line projection (see\n"
        },
        {
          "insert": "Rendering Model",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/30-rendering-model"
            }
          }
        },
        {
          "insert": ") yields one row per rendered\nline. Each row carries its source node, its depth, and a role, and the roles\ncarry the editability rule:"
        }
      ],
      "children": []
    },
    "b-10-editing-model-role-emitted-for-e-9": {
      "id": "b-10-editing-model-role-emitted-for-e-9",
      "type": "structured-table",
      "props": {
        "columns": [
          "Role",
          "Emitted for",
          "Editable"
        ],
        "rows": [
          [
            "gap",
            "Blank separator between sibling blocks",
            "No"
          ],
          [
            "open",
            "Container opening tag",
            "Only a section tag with no rendered attributes"
          ],
          [
            "close",
            "Container closing tag",
            "No"
          ],
          [
            "content",
            "Paragraph, field, raw line, code line",
            "Yes"
          ],
          [
            "fence",
            "Code block fence lines",
            "No"
          ],
          [
            "item",
            "One list item line",
            "Yes"
          ]
        ]
      },
      "children": []
    },
    "b-10-editing-model-the-invariant-that-joine-10": {
      "id": "b-10-editing-model-the-invariant-that-joine-10",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The invariant that joined rows equal the rendered string is why the editor's\nline-number gutter matches the read-only view line for line, and why any\nrenderer layout change must be mirrored by the projection in lockstep."
        }
      ],
      "children": []
    },
    "b-10-editing-model-a-section-s-open-tag-is-11": {
      "id": "b-10-editing-model-a-section-s-open-tag-is-11",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A section's open tag is editable because the tag "
        },
        {
          "insert": "is",
          "attributes": {
            "italic": true
          }
        },
        {
          "insert": " the section's name; the\nangle brackets are drawn as non-editable trim around the editor. An "
        },
        {
          "insert": "example",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "\nor "
        },
        {
          "insert": "contextUsage",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " open tag derives its text from other fields, and an\nattributed tag renders more than a name, so both stay structural."
        }
      ],
      "children": []
    },
    "b-10-editing-model-edit-points-12": {
      "id": "b-10-editing-model-edit-points-12",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Edit Points"
        }
      ],
      "children": []
    },
    "b-10-editing-model-the-ordered-list-of-care-13": {
      "id": "b-10-editing-model-the-ordered-list-of-care-13",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The ordered list of caret targets is derived from the rows: every editable\nline, except that multi-line leaf nodes ("
        },
        {
          "insert": "raw",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "codeBlock",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") contribute a\nsingle point anchored on their first content line, because they edit as one\nmulti-line value. Arrow navigation, Backspace, and Delete all resolve against\nthis list, so \"the previous editable thing\" has one definition on the whole\nsurface."
        }
      ],
      "children": []
    },
    "b-10-editing-model-committing-text-14": {
      "id": "b-10-editing-model-committing-text-14",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Committing Text"
        }
      ],
      "children": []
    },
    "b-10-editing-model-each-node-type-has-exact-15": {
      "id": "b-10-editing-model-each-node-type-has-exact-15",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Each node type has exactly one editable property:"
        }
      ],
      "children": []
    },
    "b-10-editing-model-node-type-editable-v-16": {
      "id": "b-10-editing-model-node-type-editable-v-16",
