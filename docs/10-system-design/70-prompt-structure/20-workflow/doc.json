      "id": "b-20-workflow-root-34",
      "type": "paragraph",
      "props": {
        "concepts": [
          "workflow",
          "phases",
          "state-navigation"
        ],
        "covers": "How workflow sections express state-navigated agent procedures through phases, objectives, steps, and an open question on optional phase fields.",
        "depends-on": [
          "10-system-design/70-prompt-structure/10-agent-prompt.md",
          "10-system-design/10-canonical-prompt-object.md"
        ]
      },
      "children": [
