    "b-30-presentation-indent-geometry-has-two-15": {
      "id": "b-30-presentation-indent-geometry-has-two-15",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Indent geometry has two behavioral forms because rows measure the indent they\nactually rendered, while overlays (indent guides, the drop indicator) know a\nnode's depth without reading its text; both resolve to the same visual width."
        }
      ],
      "children": []
    },
