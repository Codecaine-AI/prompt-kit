    "ui-outline-rail-heading": {
      "id": "ui-outline-rail-heading",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "The Outline Rail Is One Path With a Sliding Window"
        }
      ],
      "children": []
    },
    "ui-outline-rail-decision": {
      "id": "ui-outline-rail-decision",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "PanelOutlineList",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in "
        },
        {
          "insert": "lab/glass/zones.tsx",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " computes one SVG path from the visible rows and draws it three times in a single overlay: the faint hairline, the accent segment, and the dot. The accent segment is a "
        },
        {
          "insert": "stroke-dasharray",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " window offset along the path with "
        },
        {
          "insert": "stroke-dashoffset",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "; the dot is a zero-length dash with a round cap. Both transition with CSS, using the "
        },
        {
          "insert": "OUTLINE_MOTION_MS",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "OUTLINE_MOTION_EASE",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " constants."
        }
      ],
      "children": []
    },
    "ui-outline-rail-why": {
      "id": "ui-outline-rail-why",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Per-row rail pieces cannot animate between rows; a browser can only interpolate a dash window along one continuous path. Corners are true quarter-circle arcs, so segment lengths are analytic and the path's "
        },
        {
          "insert": "pathLength",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " equals the computed total; the window and dot land exactly on row boundaries with no measurement pass or first-paint flash. Rows are fixed at 25px for the same reason. Corner radius, rail offsets, and dot size are named constants; a radius of zero yields square corners."
        }
      ],
      "children": []
    },
    "ui-outline-rail-scope": {
      "id": "ui-outline-rail-scope",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Applies to.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " The accent and dot elements are keyed on the visible-row signature, so a fold or unfold remounts them and snaps rather than sliding across a reshaped path. Scroll-spy changes keep the same elements and animate. A "
        },
        {
          "insert": "matchMedia",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " hook disables every transition under reduced motion. "
        },
        {
          "insert": "lab/index.tsx",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " pins the active row during a click-initiated smooth scroll and releases it on "
        },
        {
          "insert": "scrollend",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or after 120ms without scroll events, so the dot glides once to the clicked row instead of following each intermediate scroll position. Future outline decorations extend the shared path rather than adding per-row drawing."
        }
      ],
      "children": []
    },
    "ui-host-controlled-view-heading": {
      "id": "ui-host-controlled-view-heading",
      "type": "heading",
      "props": {
        "level": 3
