    "b-80-kernel-boundary-prompt-kit-only-owns-the-14": {
      "id": "b-80-kernel-boundary-prompt-kit-only-owns-the-14",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Prompt-kit only owns the first part. It can include prompt-side instructions\nabout context or tools, but the executable runtime systems live outside it."
        }
      ],
      "children": []
    },
    "b-80-kernel-boundary-tool-boundary-15": {
      "id": "b-80-kernel-boundary-tool-boundary-15",
