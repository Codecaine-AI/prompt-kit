          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "--prompt-editor-rule",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ",\n"
        },
        {
          "insert": "--prompt-editor-landmark",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
