    "b-50-validation-contract-prompt-kit-can-validate-23": {
      "id": "b-50-validation-contract-prompt-kit-can-validate-23",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Prompt-kit can validate the static prompt object. It cannot prove that a runtime\ncontext loader will succeed, that a tool exists in a host registry, or that a\nconversation packet is available. Those failures should be surfaced by the host\nruntime through its own diagnostics or trace events."
        }
      ],
      "children": []
    },
    "b-50-validation-contract-flexible-by-design-24": {
